{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ViuMic",
  "version": "0.1.0",
  "identifier": "net.spacie.viumic",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --dir ui dev",
    "beforeBuildCommand": "pnpm --dir ui build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ViuMic",
        "width": 480,
        "height": 760,
        "minWidth": 380,
        "minHeight": 560,
        "center": true,
        "visible": false,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Spacie",
    "resources": {
      "../vendor/vbcable/*": "vbcable/",
      "../LICENSE-MIT": "LICENSE-MIT",
      "../LICENSE-APACHE": "LICENSE-APACHE",
      "../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "copyright": "© 2026 Spacie. Virtual microphone: VB-CABLE by VB-Audio (www.vb-cable.com), donationware.",
    "homepage": "https://github.com/abdvlrqhman/ViuMic",
    "license": "MIT OR Apache-2.0"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENEOUU5NkE3NERDNEY4MUIKUldRYitNUk5wNWFlellYdk45c3NLUWRTRi92NmtERVFoZHVoNzJTNkRQUTkvK3NyeStqVmQ2UjQK",
      "endpoints": [
        "https://github.com/abdvlrqhman/ViuMic/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
