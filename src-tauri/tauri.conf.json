{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ViuMic",
  "version": "0.1.0",
  "identifier": "com.viumic.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --dir ui dev",
    "beforeBuildCommand": "pnpm --dir ui build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ViuMic",
        "width": 480,
        "height": 760,
        "minWidth": 380,
        "minHeight": 560,
        "center": true,
        "visible": false,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "ViuMic",
    "resources": {
      "../vendor/vbcable/*": "vbcable/"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "copyright": "ViuMic contributors. Virtual microphone: VB-CABLE by VB-Audio (www.vb-cable.com)."
  }
}
